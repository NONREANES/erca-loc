# ==========================================================
# ERCA LOC — variáveis de ambiente
# Copie este arquivo para ".env" (uso local). NUNCA envie o .env para o GitHub.
# Na Railway, cadastre estas variáveis na aba "Variables" do serviço.
# ==========================================================

# Banco PostgreSQL.
# Na Railway use a referência:  ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://usuario:senha@localhost:5432/ercaloc"

# Chave secreta das sessões do painel (mínimo 32 caracteres aleatórios).
SESSION_SECRET="troque-por-uma-sequencia-aleatoria-com-mais-de-32-caracteres"

# Primeiro administrador — criado automaticamente na primeira execução,
# apenas se ainda não existir nenhum administrador. Senha com 10+ caracteres.
# Depois do primeiro acesso, troque a senha pelo painel (Minha conta).
ADMIN_EMAIL="admin@ercaloc.com.br"
ADMIN_PASSWORD="troque-esta-senha"

# Endereço público do site (usado em links de compartilhamento). Opcional.
SITE_URL="https://www.ercaloc.com.br"

# Cloudinary (opcional, recomendado): copie a "API environment variable" do painel do Cloudinary.
# Sem ela, as imagens enviadas ficam guardadas no próprio PostgreSQL.
CLOUDINARY_URL=""
CLOUDINARY_FOLDER="erca-loc"

# Tamanho máximo de cada imagem enviada pelo painel (MB).
MAX_UPLOAD_MB="5"
